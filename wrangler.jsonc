{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirror-zones",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Serve the HTML files in this repo; the Worker only handles /api/*
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: Wrangler creates the D1 database automatically on first deploy
  "d1_databases": [
    { "binding": "DB", "database_name": "mirror-zones-signups" }
  ],
  "observability": { "enabled": true }
}
